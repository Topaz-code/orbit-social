# Orbit Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite)
DATABASE_URL="file:./orbit.db"

# JWT Secret Keys
JWT_SECRET=orbit_super_secret_jwt_key_development_2026_change_in_production
JWT_REFRESH_SECRET=orbit_super_secret_refresh_jwt_key_2026_change_in_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Real-time MQTT Broker
MQTT_PORT=1883
MQTT_WS_PORT=8883
MQTT_WS_URL=ws://localhost:8883

# PeerJS WebRTC Signaling
PEERJS_PORT=5000
PEERJS_PATH=/peerjs

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_IMAGE=10485760
MAX_FILE_SIZE_VIDEO=52428800
