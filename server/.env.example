# Orbit Backend Environment Configuration Template
# DO NOT commit production secrets to version control.

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL / Local Postgres)
# Direct connection string for Supabase:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Or direct port 5432:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DATABASE_URL="file:./orbit.db"

# JWT Authentication Secrets (Generate with `openssl rand -base64 64`)
JWT_SECRET=replace_with_high_entropy_random_64_char_secret_for_production
JWT_REFRESH_SECRET=replace_with_different_random_64_char_secret_for_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Two-Factor Authentication OTP HMAC Secret
OTP_SECRET_KEY=replace_with_high_entropy_secret_for_2fa_otp_hmac_hashing

# Anti-Bot & Disposable Email Detection (https://www.usercheck.com)
USERCHECK_API_KEY=

# Supabase Storage & Database
SUPABASE_URL=https://hqmwvgtortsgowrxdkpb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=orbit-media

# Real-Time Protocols
MQTT_PORT=1883
MQTT_WS_PORT=8883
PEERJS_PORT=5000
PEERJS_PATH=/peerjs

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=orbit-social-c90ed
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
