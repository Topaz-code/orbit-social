{
  "expo": {
    "name": "Orbit",
    "slug": "orbit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#171A1C"
    },
    "ios": {
      "supportsTablet": true,
      "bitcode": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Orbit to access your camera for stories, profile photos, and video calls.",
        "NSMicrophoneUsageDescription": "Allow Orbit to access your microphone for voice notes, voice calls, and video calls.",
        "NSPhotoLibraryUsageDescription": "Allow Orbit to access your photos for posts, stories, chat attachments, and profile pictures.",
        "NSPhotoLibraryAddUsageDescription": "Allow Orbit to save media to your photo library.",
        "UIBackgroundModes": ["audio", "voip", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#171A1C"
      },
      "package": "com.orbit.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "CHANGE_NETWORK_STATE",
        "ACCESS_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "WAKE_LOCK",
        "VIBRATE",
        "INTERNET",
        "USE_FULL_SCREEN_INTENT",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "orbit-web-6z3b.onrender.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Orbit to access your camera for stories, profile photos, and video calls.",
          "microphonePermission": "Allow Orbit to access your microphone for voice notes, voice calls, and video calls.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Orbit to access your photos for posts, stories, chat attachments, and profile pictures.",
          "cameraPermission": "Allow Orbit to access your camera for stories, profile photos, and chat."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Orbit to access your microphone for voice notes, voice calls, and video calls."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "topazartz",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "02f6b6eb-fd29-40af-a5d8-94fc85c4c94d"
      }
    }
  }
}
